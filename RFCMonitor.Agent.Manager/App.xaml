<Application x:Class="MonitorRFC.Agent.Manager.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="0,2,0,6"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,2,0,6"/></Style>
  <Style TargetType="Button"><Setter Property="Margin" Value="0,3,6,3"/><Setter Property="Padding" Value="9,5"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,3,12,5"/></Style>
 </Application.Resources>
</Application>
