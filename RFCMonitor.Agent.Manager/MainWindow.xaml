<Window x:Class="MonitorRFC.Agent.Manager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MonitorRFC · Administrador" Width="1000" Height="690" MinWidth="860" MinHeight="580" Background="#F7F8FA">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock Text="MonitorRFC" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Administración local del Worker SAT y DOF" Foreground="#475569"/></StackPanel>
  <Border DockPanel.Dock="Bottom" Background="#E2E8F0" Padding="8" Margin="0,10,0,0"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border>
  <TabControl>
   <TabItem Header="Servicio"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Ubicar / seleccionar servicio" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ServicePath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="Seleccionar…" Command="{Binding Action}" CommandParameter="browse"/></Grid><Border Grid.Row="1" Background="#E8F1FC" Padding="10" Margin="0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="Estado: " FontWeight="SemiBold"/><TextBlock Text="{Binding ServiceStatus}"/><TextBlock Text=" · Inicio automático con Windows" Margin="10,0,0,0" Foreground="#475569"/><Button Content="Actualizar" Command="{Binding Action}" CommandParameter="status" Margin="18,0,0,0"/></StackPanel></Border><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="Instalar" Command="{Binding Action}" CommandParameter="install" IsEnabled="{Binding CanInstall}"/><Button Content="Iniciar" Command="{Binding Action}" CommandParameter="start" IsEnabled="{Binding CanStart}"/><Button Content="Detener" Command="{Binding Action}" CommandParameter="stop" IsEnabled="{Binding CanStop}"/><Button Content="Reiniciar" Command="{Binding Action}" CommandParameter="restart" IsEnabled="{Binding CanRestart}"/><Button Content="Desinstalar" Command="{Binding Action}" CommandParameter="uninstall" IsEnabled="{Binding CanUninstall}"/><Button Content="Ejecutar ahora" Command="{Binding Action}" CommandParameter="run"/><Button Content="Recargar configuración" Command="{Binding Action}" CommandParameter="reload"/></WrapPanel><TextBox Grid.Row="1" Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/></Grid></Grid></TabItem>
   <TabItem Header="Conexión y fuentes"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Conexión a SQL Server" FontWeight="SemiBold"/><TextBlock Text="Servidor"/><TextBox Text="{Binding SqlServer, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Base de datos"/><TextBox Text="{Binding SqlDatabase, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Usuario"/><TextBox Text="{Binding SqlUser, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Contraseña (vacía conserva la guardada)"/><PasswordBox Padding="7" Margin="0,3,0,7" PasswordChanged="SqlChanged"/><WrapPanel><CheckBox Content="Cifrar conexión" IsChecked="{Binding SqlEncrypt}"/><CheckBox Content="Confiar en certificado" IsChecked="{Binding SqlTrustServerCertificate}"/></WrapPanel><TextBlock Text="Directorio de datos del servicio"/><TextBox Text="{Binding Options.DataDirectory}"/><TextBlock Text="Aquí se conservan configuración protegida, evidencias descargadas, ejecuciones y correos pendientes." TextWrapping="Wrap" Foreground="#475569" FontSize="11"/><TextBlock Text="Fuentes a procesar" FontWeight="SemiBold" Margin="0,8,0,0"/><CheckBox Content="Descargar y procesar listados publicados por el SAT" IsChecked="{Binding Options.SatEnabled}"/><CheckBox Content="Consultar y procesar publicaciones del Diario Oficial (DOF)" IsChecked="{Binding Options.DofEnabled}"/><TextBlock Text="DOF: consultar desde"/><ComboBox ItemsSource="{Binding DofStartModes}" SelectedItem="{Binding DofStartMode}"/><TextBlock Text="Días hacia atrás (predeterminado: 7)"/><TextBox Text="{Binding DofDaysBack}"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Listados SAT habilitados" FontWeight="SemiBold"/><TextBlock Text="Marque los listados que desea descargar." Foreground="#475569" Margin="0,0,0,5"/><ListBox ItemsSource="{Binding Sources}" Height="340"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled}"/></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Content="Guardar configuración" Command="{Binding Action}" CommandParameter="save"/><Button Content="Probar SQL" Command="{Binding Action}" CommandParameter="sql"/><Button Content="Cobertura SQL" Command="{Binding Action}" CommandParameter="coverage"/><Button Content="Restaurar respaldo" Command="{Binding Action}" CommandParameter="restore"/></WrapPanel></StackPanel></Grid></ScrollViewer></TabItem>
   <TabItem Header="Programación"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="Programación automática" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="Habilitar programación automática" IsChecked="{Binding Options.Schedule.Enabled}"/><CheckBox Content="Ejecutar una recolección al iniciar Windows" IsChecked="{Binding Options.Schedule.RunOnStartup}"/><TextBlock Text="Modalidad"/><ComboBox ItemsSource="{Binding ScheduleModes}" SelectedItem="{Binding SelectedScheduleMode}"/><TextBlock Text="Zona horaria"/><TextBox Text="{Binding Options.Schedule.TimeZone}"/><TextBlock Text="Diaria (horas): ejecuta todos los días a una o varias horas." TextWrapping="Wrap" Foreground="#475569"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Horas diarias (HH:mm; HH:mm)"/><TextBox Text="{Binding DailyHours}"/><TextBlock Text="Predeterminado: 08:00; 20:00 (cada 12 horas). Solo aplica a Diaria (horas)." TextWrapping="Wrap" Foreground="#1E3A5F"/><TextBlock Text="Intervalo en minutos (Cada N minutos)"/><TextBox Text="{Binding Options.Schedule.IntervalMinutes}"/><TextBlock Text="Hora HH:mm (Diaria una hora / Semanal)"/><TextBox Text="{Binding Options.Schedule.LocalTime}"/><TextBlock Text="Días semanales: 0 domingo a 6 sábado"/><TextBox Text="{Binding WeekDays}"/><TextBlock Text="Cron de cinco campos (Cron avanzado)"/><TextBox Text="{Binding Options.Schedule.Cron}"/><Button Content="Guardar y aplicar" Command="{Binding Action}" CommandParameter="save" HorizontalAlignment="Left"/></StackPanel></Grid></TabItem>
   <TabItem Header="Correo"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,10,0"><StackPanel><CheckBox Content="Enviar resumen por correo" IsChecked="{Binding Options.Email.Enabled}"/><TextBlock Text="SMTP"/><TextBox Text="{Binding Options.Email.Host}"/><TextBlock Text="Puerto"/><TextBox Text="{Binding Options.Email.Port}"/><TextBlock Text="TLS"/><ComboBox SelectedItem="{Binding Options.Email.Security}" ItemsSource="{Binding TlsModes}"/><TextBlock Text="Usuario"/><TextBox Text="{Binding Options.Email.UserName}"/><TextBlock Text="Contraseña SMTP (vacía conserva la guardada)"/><PasswordBox Padding="7" PasswordChanged="SmtpChanged"/><TextBlock Text="Remitente"/><TextBox Text="{Binding Options.Email.SenderAddress}"/><TextBlock Text="Destinatarios (separar con ;)"/><TextBox Text="{Binding To}"/><TextBlock Text="Asunto"/><TextBox Text="{Binding Options.Email.SubjectTemplate}"/><TextBlock Text="Plantilla HTML"/><TextBox Text="{Binding Options.Email.HtmlTemplate}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto"/><WrapPanel><Button Content="Visualizar HTML" Command="{Binding Action}" CommandParameter="preview"/><Button Content="Guardar" Command="{Binding Action}" CommandParameter="save"/><Button Content="Correo de prueba" Command="{Binding Action}" CommandParameter="test-email"/></WrapPanel></StackPanel></ScrollViewer><Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Vista previa de la plantilla" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="El HTML se muestra completo como correo y se bloquean recursos externos." Foreground="#475569" FontSize="11"/><WebBrowser x:Name="PreviewBrowser" Grid.Row="2" Margin="0,6,0,0"/></Grid></Border></Grid></TabItem>
  </TabControl>
 </DockPanel>
</Window>
